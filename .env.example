# Copy to web-school/.env

VITE_API_URL=http://localhost:4000


# The Protomaps demo archive this used to default to was removed upstream in
# August 2026, so there is no working public fallback. Point this at your own
# PMTiles archive on R2; until you do, the maps render markers and routes over
# an empty background and say so on screen.
#
# For production, build your own extract and put its URL here:
#   pmtiles extract https://build.protomaps.com/20260801.pmtiles mangalore.pmtiles \
#     --bbox=74.72,12.75,74.98,13.10
# Then on the R2 bucket allow your console's origin and expose the Range header.
# VITE_TILES_URL=https://tiles.yourdomain.com/mangalore.pmtiles
